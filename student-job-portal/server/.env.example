# Copy this file to .env and fill in the values
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:postgres@localhost:5432/student_job_portal

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# Used only by "npm run seed" to create the first admin account
ADMIN_EMAIL=admin@school.edu
ADMIN_PASSWORD=ChangeMe123!
